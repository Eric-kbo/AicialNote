# Copy to server/.env for local development. Never commit the real file.

# Where users open AicialNote. OAuth redirect URIs are derived from it:
#   <AICIALNOTE_PUBLIC_URL>/auth/google/callback
#   <AICIALNOTE_PUBLIC_URL>/auth/microsoft/callback
# In development the Vite dev server (5173) proxies /auth to this server.
AICIALNOTE_PUBLIC_URL=http://localhost:5173
AICIALNOTE_ADDR=:8080

# Encrypts session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
AICIALNOTE_SESSION_KEY=

# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal + work/school accounts, "consumers" = personal only
MICROSOFT_TENANT=common
